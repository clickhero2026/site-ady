# ── Bitrix24 — obrigatório pra o formulário de lead funcionar de verdade ──
# URL completa do webhook de entrada (Bitrix24 > Aplicativos > Webhooks de
# entrada). Precisa terminar em "/". Sem essa variável, /api/lead ainda
# funciona (retorna sucesso e loga o lead no console), mas nada chega no CRM.
# Ex.: https://SEUDOMINIO.bitrix24.com.br/rest/1/xxxxxxxxxxxxxxxx/
BITRIX_WEBHOOK_URL=

# Opcionais — códigos de campo customizado no CRM (ex. UF_CRM_1700000000)
# caso você crie campos dedicados pra Segmento e Plano de interesse.
# Sem eles, os dois valores vão dentro do campo de comentários do lead.
BITRIX_FIELD_SEGMENTO=
BITRIX_FIELD_PLANO=

# Idem, pros campos específicos da inscrição do /workshop (segmento tem
# opções diferentes das da home, por isso é um código separado).
BITRIX_FIELD_SEGMENTO_WORKSHOP=
BITRIX_FIELD_INDICADO_POR=

# ── WhatsApp — botão da página /obrigado ──
# Número em formato E.164 sem "+", ex. 5511999999999. Sem essa variável, o
# botão de WhatsApp some da página /obrigado (não mostramos link quebrado).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Google Tag Manager (via Stape / server-side tagging) ──
# ID do container, formato GTM-XXXXXXX.
#
# O container é carregado pelo loader do Stape em
# conversionapi.useady.com.br (ver src/app/layout.tsx), que se identifica
# por um parâmetro opaco próprio, NÃO por este ID — ou seja, o loader
# carrega mesmo sem esta variável. Ela é usada só pelo <noscript> de
# fallback, que fica de fora se ela estiver vazia.
#
# Tudo passa só pelo GTM nesse projeto (decisão do Rafael) — sem Meta Pixel
# instalado direto no app. Se precisar do Pixel, ele entra como tag dentro
# do próprio GTM, disparado pelos eventos page_view, view_item_list,
# select_plan e generate_lead.
NEXT_PUBLIC_GTM_ID=

# ── Workshop (/workshop) ──
# Número que recebe as mensagens da página /workshop/obrigado (mesmo
# formato E.164 sem "+" do NEXT_PUBLIC_WHATSAPP_NUMBER). Sem essa
# variável, o botão "Falar com a gente no WhatsApp" some da página.
# O número configurado é o do Jean, mantido deliberadamente — só o texto
# visível ao usuário foi generalizado pra "a gente".
NEXT_PUBLIC_WORKSHOP_WHATSAPP=

# Link da sala do Google Meet, usado só dentro do arquivo .ics gerado no
# botão "Adicionar na minha agenda" — nunca exposto solto na página antes
# da inscrição. Sem essa variável, o .ics é gerado sem link na descrição.
NEXT_PUBLIC_WORKSHOP_MEET_LINK=

# Connection string do Postgres (Neon) — banco dedicado a este projeto,
# criado dentro da mesma conta Neon do clickhero-site mas separado (não é
# o banco que o clickhero-site já usa). Formato:
#   postgres://usuario:senha@ep-xxxxx.neon.tech/ady_workshop?sslmode=require
# Schema em db/workshop_leads.sql (rodar uma vez no editor SQL do Neon).
# Sem essa variável, /api/workshop-lead ainda funciona (retorna sucesso e
# loga o lead no console como erro — é a única gravação durável do lead
# nesta fase, diferente do Bitrix, que é só melhor esforço).
WORKSHOP_DATABASE_URL=

# ── Teste grátis de 7 dias (/api/teste7d/*) ──
# Connection string do Postgres (Neon) onde roda
# db/migrations/20261027_teste7d_inscricoes.sql. Obrigatória: sem ela as
# rotas do teste7d respondem erro (o banco gera o id do cookie da etapa 2).
DATABASE_URL=

# Segredo (mínimo 32 caracteres, aleatório) que assina o cookie httpOnly
# da inscrição e gera o ip_hash. Ex.: `openssl rand -base64 48`. Trocar
# invalida os cookies em andamento.
TESTE7D_COOKIE_SECRET=

# Liga a integração do teste7d com o Bitrix24. Padrão: false. Qualquer
# valor diferente de "true" desliga: as rotas do teste7d não chamam o
# Bitrix nem leem BITRIX_WEBHOOK_URL, bitrix_sync_status fica 'pendente'
# e o /api/teste7d/reenviar-bitrix responde que está desligada. Só ligar
# quando o Bitrix tiver webhook/REST (o plano gratuito não tem); depois de
# ligar, chamar o reenvio leva as inscrições que ficaram pendentes.
TESTE7D_BITRIX_ATIVO=false

# Chave do header `x-teste7d-chave` do POST /api/teste7d/reenviar-bitrix,
# que reprocessa no Bitrix as inscrições em pendente/erro.
TESTE7D_REENVIO_KEY=

# Opcionais do Bitrix pro teste7d (mesmo padrão dos BITRIX_FIELD_* acima):
# campo customizado pra versão da landing page (sem ele, vai em COMMENTS)
# e a etapa (STATUS_ID) em que o lead nasce, ex. a de "qualificado".
BITRIX_FIELD_LP_VARIANT=
BITRIX_TESTE7D_STATUS_ID=

# Link do evento do Calendly embutido na etapa 2 (usado nas páginas).
NEXT_PUBLIC_CALENDLY_URL=

# ── LP do teste grátis (lp.useady.com.br) ──
# O Google só é citado na LP com esta flag ligada (padrão). "false" volta
# os textos e mockups para só Instagram e Facebook. Entra no build:
# trocar exige novo deploy. Ver src/lib/flags.ts.
NEXT_PUBLIC_GOOGLE_ADS_LIVE=true

# Hosts extras que também servem a LP (separados por vírgula), além de
# qualquer host que comece com "lp." — ex. um domínio de preview da
# Vercel pra testar a LP antes de ir pra produção. Ver src/proxy.ts.
LP_EXTRA_HOSTS=

# Só desenvolvimento — NUNCA na Vercel. Aponta o driver do Neon pra um
# proxy HTTP local (imagem ghcr.io/timowilhelm/local-neon-http-proxy na
# frente de um Postgres local), pra testar o fluxo do teste grátis sem
# tocar no banco de verdade. Com ele, DATABASE_URL fica:
#   postgres://postgres:postgres@db.localtest.me:5432/postgres
NEON_LOCAL_SQL_ENDPOINT=
