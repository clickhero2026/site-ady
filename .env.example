# ── Bitrix24 — obrigatório pra o formulário de lead funcionar de verdade ──
# URL completa do webhook de entrada (Bitrix24 > Aplicativos > Webhooks de
# entrada). Precisa terminar em "/". Sem essa variável, /api/lead ainda
# funciona (retorna sucesso e loga o lead no console), mas nada chega no CRM.
# Ex.: https://SEUDOMINIO.bitrix24.com.br/rest/1/xxxxxxxxxxxxxxxx/
BITRIX_WEBHOOK_URL=

# Opcionais — códigos de campo customizado no CRM (ex. UF_CRM_1700000000)
# caso você crie campos dedicados pra Segmento e Plano de interesse.
# Sem eles, os dois valores vão dentro do campo de comentários do lead.
BITRIX_FIELD_SEGMENTO=
BITRIX_FIELD_PLANO=

# ── WhatsApp — botão da página /obrigado ──
# Número em formato E.164 sem "+", ex. 5511999999999. Sem essa variável, o
# botão de WhatsApp some da página /obrigado (não mostramos link quebrado).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Google Tag Manager ──
# ID do container, formato GTM-XXXXXXX. Sem essa variável, o GTM não carrega
# e os eventos (page_view, view_item_list, select_plan, generate_lead) ficam
# só se acumulando num dataLayer que ninguém lê — inofensivo, mas nada
# dispara de verdade sem essa variável.
#
# Tudo passa só pelo GTM nesse projeto (decisão do Rafael) — sem Meta Pixel
# instalado direto no app. Se precisar do Pixel, ele entra como tag dentro
# do próprio GTM, disparado por esses mesmos eventos.
NEXT_PUBLIC_GTM_ID=
